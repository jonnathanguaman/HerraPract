# Inventory Master - production Docker environment
# Copy this file to .env and adjust secrets before running docker compose.

# Frontend published on the host machine.
FRONTEND_PORT=80

# API runs inside Docker and is reached by the frontend through Nginx.
API_PORT=4005
NODE_ENV=production
JWT_SECRET=change-this-secret-before-running

# PostgreSQL runs inside Docker as postgres:5432.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=herramientas_app
DB_USER=postgres
DB_PASSWORD=change-this-password-before-running

# Keep false for production. Set true only when intentionally syncing schema changes.
DB_SYNC_ALTER=false
Jonnathan, Daniel, Santiago
